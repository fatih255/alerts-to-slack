{
  "name": "alerts-to-slack",
  "version": "1.0.0",
  "description": "Turns CloudWatch and Sentry alerts into grouped, readable Slack messages.",
  "private": true,
  "license": "MIT",
  "author": "Fatih İnci",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx scripts/demo.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
