# Where messages go. The default is the local mock receiver started by `npm run dev`.
SLACK_WEBHOOK_URL=http://127.0.0.1:3502/webhook

# Required on POST /sns, as an X-Alert-Secret header or the password of HTTP Basic auth.
# Fake local value. Use a long random string anywhere real.
ALERT_SHARED_SECRET=local-dev-shared-secret

# The client secret of your Sentry integration. Used to check Sentry-Hook-Signature on POST /sentry.
# Fake local value.
SENTRY_CLIENT_SECRET=local-dev-sentry-client-secret

# Repeats of the same alert inside this window are counted instead of posted.
# The service defaults to 300; `npm run dev` uses 10 so the demo doesn't take five minutes.
GROUP_WINDOW_SECONDS=10

# Local ports (only used by `npm run dev` and `npm run demo`).
PORT=3501
MOCK_SLACK_PORT=3502
